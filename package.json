{
  "name": "techteam-deploy-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "qa:deploy": "tsx scripts/qa-deploy-flow.ts && tsx scripts/qa-deploy-flow-runtime-check.ts && tsx scripts/qa-github-dual-mode.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "tsx": "^4.19.2"
  }
}
