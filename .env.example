NODE_ENV=development
DATABASE_URL=postgresql://deploy_os:deploy_os_password@localhost:15434/deploy_os?schema=public
REDIS_URL=redis://localhost:6380
DEPLOY_OS_PUBLIC_URL=https://vps.techteamlead.com
DEPLOY_OS_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DEPLOY_OS_VPS_IP=198.54.121.88
DEPLOY_OS_CNAME_TARGET=vps.techteamlead.com
DEPLOY_OS_APPS_DOMAIN=apps.techteamlead.com
POSTGRES_ADMIN_URL=postgresql://deploy_os:deploy_os_password@localhost:15434/postgres
POSTGRES_PROJECT_HOST=postgres
POSTGRES_PROJECT_PORT=5432
RUNNER_WORKSPACE=/opt/hredoy-deploy/projects
RUNNER_DOCKER_NETWORK=techteam-deploy-network
RUNNER_CONCURRENCY=1
RUNNER_PROJECT_LOCK_WAIT_MS=1800000
RUNNER_PROJECT_LOCK_STALE_MS=7200000
RUNNER_MEMORY_LIMIT=1g
RUNNER_CPU_LIMIT=1
RUNNER_PORT_RANGE_START=20000
RUNNER_PORT_RANGE_END=29999
RUNNER_HEALTH_ATTEMPTS=45
RUNNER_BUILD_TIMEOUT_MS=1200000
RUNNER_NGINX_ENABLED=true
RUNNER_NGINX_AVAILABLE_DIR=/etc/nginx/sites-available
RUNNER_NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
RUNNER_AUTO_SSL=false
RUNNER_PUBLIC_SCHEME=http
RUNNER_SSL_EMAIL=admin@example.com
RUNNER_REMOVE_FAILED_IMAGE=false

# GitHub App environment override (optional)
# Normally leave these empty. The first Connect GitHub click uses GitHub's App
# manifest flow and stores the returned App credentials encrypted in PostgreSQL.
# Set these only when an externally registered GitHub App should override the
# managed configuration.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Recommended override format: base64 of the PEM private key.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
